# Two traps live here, both from pinning a pnpm version.
#
# First: mise and Homebrew ship pnpm 10.x, that pnpm reads "packageManager"
# here, downloads a second copy of itself into ~/Library/pnpm, and on a machine
# where that download half-succeeds the shim is a script without a shebang, so
# every command dies with "Unknown system error -8". This switch asks pnpm not
# to do that; `engines` in package.json already states the floor.
manage-package-manager-versions=false

# Second: Node 22's bundled corepack (0.31) only knows how to launch pnpm
# through bin/pnpm.cjs, and pnpm 12 ships bin/pnpm.mjs only. With
# "packageManager": "pnpm@12.21.0" every `corepack pnpm …` therefore fails with
# MODULE_NOT_FOUND … bin/pnpm.cjs. pnpm 11.28.12 ships both files, which is why
# package.json pins it: corepack works, and so does a plain `pnpm`.
