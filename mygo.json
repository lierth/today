{
  "name": "Today",
  "slug": "today",
  "identifier": "com.lierth.today",
  "version": "0.2.0",
  "main": ".",
  "icon": "resources/icon.png",
  "urlSchemes": [
    "today"
  ],
  "macos": {
    "infoPlist": {
      "LSUIElement": true,
      "NSLocalNetworkUsageDescription": "Today 需要访问局域网，才能让桌上的显示屏取到今天的事项。"
    }
  },
  "devUrl": "http://localhost:5173",
  "devCommand": "corepack pnpm -C frontend install --frozen-lockfile && corepack pnpm -C frontend/desktop dev",
  "buildCommand": "sh scripts/build-web.sh",
  "frontendDist": "frontend/desktop/dist",
  "bindings": "frontend/desktop/src/mygo.ts",
  "resourcesExclude": [
    "gen",
    "*.svg"
  ]
}
